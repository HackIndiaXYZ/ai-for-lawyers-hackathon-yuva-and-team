# Sandhi settings. Copy this file to ".env.local" for local work, and add the same values in
# Vercel (Project > Settings > Environment Variables) for the live site.
# NEVER commit a file that contains real keys. ".env.local" is ignored by git on purpose.

# ---------------------------------------------------------------------------
# The real AI. Leave this EMPTY to run in demo mode (sample answers, free).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: use different models. These are the defaults.
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# Protection against abuse and runaway cost
# ---------------------------------------------------------------------------
# Upstash Redis makes the rate limit hold across every server instance.
# Create a free database at https://upstash.com and copy the two REST values here.
# Without them, limits are per server instance (still useful, but only a soft limit).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The most real-AI requests Sandhi will serve in one day (default 2000).
# SANDHI_DAILY_AI_CAP=2000

# ---------------------------------------------------------------------------
# Developers only: point the AI calls at a fake server in tests.
# Both must be set, otherwise ANTHROPIC_BASE_URL is ignored on purpose.
# ---------------------------------------------------------------------------
# ANTHROPIC_BASE_URL=http://localhost:4010
# SANDHI_ALLOW_TEST_BASE_URL=1
